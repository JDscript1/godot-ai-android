extends RefCounted

func run(planner: GDScript, check: Callable) -> void:
	var plan = planner.new()
	var pending = [{"step": "Verify victory", "status": "pending"}]
	plan.reset("execute-contract")
	plan.update({"tasks": pending, "phase": "executing"})
	var before: Dictionary = plan.snapshot()
	var rejected: Dictionary = plan.update({"tasks": pending, "phase": "completed", "intent": "propose"})
	check.call(rejected.get("code") == "intent_locked" and plan.snapshot() == before, "An execution cannot discard unfinished work by recasting itself as a completed proposal")
	plan.update({"tasks": pending, "phase": "planning"})
	rejected = plan.update({"tasks": pending, "phase": "planning", "intent": "propose"})
	check.call(rejected.get("code") == "intent_locked" and plan.intent == "execute", "Returning to planning cannot remove the execution intent lock")
	var restored = planner.new()
	restored.restore(plan.snapshot(), true)
	check.call((restored.get("execution_started") == true) and restored.update({"tasks": pending, "intent": "propose"}).get("code") == "intent_locked", "The execution contract survives restart while replanning")
	plan.pause()
	restored.restore(plan.snapshot(), true)
	check.call((restored.get("execution_started") == true), "Paused execution preserves its contract")
	plan.update({"tasks": pending, "phase": "blocked"})
	restored.restore(plan.snapshot(), true)
	check.call((restored.get("execution_started") == true) and restored.update({"tasks": pending, "intent": "propose"}).get("code") == "intent_locked", "An explicit blocker cannot be rewritten as a successful proposal")
	var stable: Dictionary = restored.snapshot()
	check.call(not restored.restore({"phase": "executing", "steps": []}).get("ok", false) and restored.snapshot() == stable, "A rejected restore preserves the previous execution contract atomically")
	plan.reset("actual-proposal", true)
	check.call(plan.update({"tasks": pending, "phase": "completed"}, true).get("ok", false) and not (plan.get("execution_started") == true), "A user proposal still describes future work without requiring execution")
	check.call(restored.restore(plan.snapshot()).get("ok", false) and not (restored.get("execution_started") == true) and restored.intent == "propose", "Restoring another conversation replaces the previous turn contract")
	plan.reset("new-task")
	check.call(not (plan.get("execution_started") == true) and plan.update({"tasks": pending, "intent": "propose"}).get("ok", false), "An actual new turn can choose a proposal before execution")
